# The web-app demo, run two ways: a desktop window, or Bun.serve in a browser.

set shell := ["pwsh", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $PSNativeCommandUseErrorActionPreference = $true; trap { if ($_.Exception -is [System.Management.Automation.NativeCommandExitException]) { exit $_.Exception.ExitCode }; break };"]

exe := "web-app"
# Bun embeds the exe file icon only when the build host is Windows; a Mac-built Windows exe gets Bun's stock icon (README, "Platforms").
win_icon := if os() == "windows" { "--windows-icon=build/app.ico" } else { "" }

@_default:
    just --justfile "{{module_file()}}" --list


install:
    bun install --cwd ../..

# Both modes serve the same files
frontend: install
    bun build packages/web-app-frontend/src/main.tsx --outdir build/frontend --minify

# Web app: Bun.serve + WebSockets on http://127.0.0.1:4747 (PORT and HOST to change)
serve: frontend
    bun run web.ts

# WEBVIEW_DEBUG=1 for devtools
app: frontend
    bun run app.ts

compile: frontend compile-win compile-mac mac-app

icons:
    bun scripts/write-icons.ts

compile-win: icons
    bun build --compile --target=bun-windows-x64 --windows-hide-console {{win_icon}} --minify --sourcemap app.ts app-worker.ts --outfile dist/{{exe}}-windows-x64.exe

compile-mac:
    bun build --compile --target=bun-darwin-arm64 --minify --sourcemap app.ts app-worker.ts --outfile dist/{{exe}}-macos-arm64

mac-app: icons
    bun ../../src/make-app.ts --name "Web App" --bundle-id dev.mrowr.web-app --binary dist/{{exe}}-macos-arm64 --icns build/AppIcon.icns --out dist

# ri on a missing path fails the recipe
clean:
    if (Test-Path build) { ri build -r -fo }
    if (Test-Path dist) { ri dist -r -fo }
