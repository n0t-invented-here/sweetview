{
  "name": "@n1h/web-pets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pet for any web page: one of Kenney's Cube Pets, Mini Characters or Blocky Characters, or any animated glTF given as a spec, rendered with Babylon.js in a see-through canvas that drops in at a point, lands on the bottom edge (or on another pet's head) and lives along it, and can be picked up and thrown with the mouse. A framework-free createPet() and a React <Pet> component.",
  "license": "MIT OR 0BSD",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "assets",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./packs/cube-pets": "./src/packs/cube-pets/index.ts",
    "./packs/cube-pets/*": "./src/packs/cube-pets/*.ts",
    "./packs/mini-characters": "./src/packs/mini-characters/index.ts",
    "./packs/mini-characters/*": "./src/packs/mini-characters/*.ts",
    "./packs/blocky-characters": "./src/packs/blocky-characters/index.ts",
    "./packs/blocky-characters/*": "./src/packs/blocky-characters/*.ts",
    "./assets/*": "./assets/*"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@babylonjs/loaders": "^9.35.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
