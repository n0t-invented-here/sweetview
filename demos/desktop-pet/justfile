# The desktop pet. `just demos desktop-pet <recipe>` from the repo root, or
# `just <recipe>` here. `compile` does everything: the pages, the executables.

# pwsh with errors terminating; a failing native command ends the recipe with its own exit code
set shell := ["pwsh", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $PSNativeCommandUseErrorActionPreference = $true; trap { if ($_.Exception -is [System.Management.Automation.NativeCommandExitException]) { exit $_.Exception.ExitCode }; break };"]

exe := "desktop-pet"
# Bun embeds the exe file icon only when the build host is Windows; a Mac-built Windows exe gets Bun's stock icon (README, "Platforms").
win_icon := if os() == "windows" { "--windows-icon=build/app.ico" } else { "" }

# `just demos desktop-pet`: this app's recipes
@_default:
    just --justfile "{{module_file()}}" --list


# Workspace dependencies (the repo root is the Bun workspace); fast when nothing changed
install:
    bun install --cwd ../..

# Bundle the pet page into build/frontend and the settings page into build/settings
frontend: install
    bun build frontend/main.ts --outdir build/frontend --minify
    bun build settings/main.tsx --outdir build/settings --minify

# Run the window uncompiled (WEBVIEW_DEBUG=1 for devtools)
app: frontend
    bun run app.ts

# Everything: page, Windows exe, macOS binary, into dist/
compile: frontend compile-win compile-mac mac-app

# The icon files the executables embed: build/app.ico (Windows) and build/AppIcon.icns (macOS bundle)
icons: install
    bun scripts/write-icons.ts

compile-win: frontend icons
    bun build --compile --target=bun-windows-x64 --windows-hide-console {{win_icon}} --minify --sourcemap app.ts app-worker.ts --outfile dist/{{exe}}-windows-x64.exe

compile-mac: frontend
    bun build --compile --target=bun-darwin-arm64 --minify --sourcemap app.ts app-worker.ts --outfile dist/{{exe}}-macos-arm64

# The .app bundle around the macOS binary, with build/AppIcon.icns (the cat) as its Finder and Dock icon (sweetview's make-app script)
mac-app: icons
    bun ../../src/make-app.ts --name Pet --bundle-id dev.mrowr.pet --binary dist/{{exe}}-macos-arm64 --icns build/AppIcon.icns --out dist

# Remove build/ and dist/, each only if present: ri on a missing path fails the recipe
clean:
    if (Test-Path build) { ri build -r -fo }
    if (Test-Path dist) { ri dist -r -fo }

