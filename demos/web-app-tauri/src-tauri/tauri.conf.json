{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web App (Tauri)",
  "version": "0.1.0",
  "identifier": "dev.mrowr.web-app-tauri",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Web App (Tauri)",
        "width": 1100,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
