{
  "name": "@n1h/sweetview-native",
  "version": "1.0.0",
  "type": "module",
  "description": "Native windows, tabs, system menus, trays, and notifications for Bun.",
  "license": "MIT OR 0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0t-invented-here/sweetview.git"
  },
  "homepage": "https://github.com/n0t-invented-here/sweetview#readme",
  "bugs": {
    "url": "https://github.com/n0t-invented-here/sweetview/issues"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.worker.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./hit-regions": "./src/hit-regions.ts",
    "./internal": "./src/internal.ts",
    "./win32/api": "./src/win32/api.ts",
    "./win32/shortcuts": "./src/win32/shortcuts.ts",
    "./win32/strip-shared": "./src/win32/strip-shared.ts",
    "./win32/tab-window": "./src/win32/tab-window.ts",
    "./win32/window": "./src/win32/window.ts",
    "./win32/menu": "./src/win32/menu.ts",
    "./win32/message-window": "./src/win32/message-window.ts",
    "./darwin/objc": "./src/darwin/objc.ts",
    "./darwin/screen": "./src/darwin/screen.ts",
    "./darwin/tabs": "./src/darwin/tabs.ts",
    "./darwin/window": "./src/darwin/window.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@n1h/sweetview-settings": "workspace:*"
  }
}
