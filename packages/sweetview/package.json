{
  "name": "@n1h/sweetview",
  "version": "1.0.0",
  "type": "module",
  "description": "Desktop windows, webviews, native tabs, and typed IPC for Bun applications.",
  "license": "MIT OR 0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0t-invented-here/sweetview.git"
  },
  "homepage": "https://github.com/n0t-invented-here/sweetview#readme",
  "bugs": {
    "url": "https://github.com/n0t-invented-here/sweetview/issues"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.worker.ts",
    "file-imports.d.ts",
    "prebuilt/binding.d.ts",
    "prebuilt/*.node"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./page": "./src/page.ts",
    "./build": "./src/build.ts",
    "./settings-store": "./src/settings-store.ts",
    "./window-chrome": "./src/window-chrome.ts",
    "./ipc": "./src/ipc/index.ts",
    "./ipc-ws": "./src/ipc-ws/index.ts",
    "./ipc-ws/server": "./src/ipc-ws/server.ts",
    "./ipc-ws/client": "./src/ipc-ws/client.ts",
    "./ipc-electron": "./src/ipc-electron/index.ts",
    "./ipc-electron/client": "./src/ipc-electron/client.ts",
    "./ipc-electron/preload": "./src/ipc-electron/preload.ts",
    "./ipc-electron/server": "./src/ipc-electron/server.ts",
    "./ipc-tauri": "./src/ipc-tauri/index.ts",
    "./ipc-tauri/client": "./src/ipc-tauri/client.ts",
    "./native": "./src/native/index.ts",
    "./native/hit-regions": "./src/native/hit-regions.ts",
    "./file-imports": {
      "types": "./file-imports.d.ts"
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "napi": {
    "binaryName": "sweetview-webview",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "dependencies": {
    "@n1h/sweetview-ipc": "workspace:*",
    "@n1h/sweetview-ipc-ws": "workspace:*",
    "@n1h/sweetview-ipc-electron": "workspace:*",
    "@n1h/sweetview-ipc-tauri": "workspace:*",
    "@n1h/sweetview-native": "workspace:*",
    "@n1h/sweetview-settings": "workspace:*",
    "@n1h/sweetview-build": "workspace:*"
  },
  "peerDependencies": {
    "@n1h/sweetview-webview-bun": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "@n1h/sweetview-webview-bun": {
      "optional": true
    }
  }
}
