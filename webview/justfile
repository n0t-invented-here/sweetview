# The webview-bun fork (branch sweetview) and its webview submodule (branch
# sweetview), cloned into webview-bun/ here, for working on the library that
# @n1h/sweetview-webview-bun ships. `just webview <recipe>` from the repo root,
# or `just <recipe>` here. The apps do not need this: they load the library
# from the npm package.

set shell := ["pwsh", "-NoProfile", "-Command"]

fork := "git@github.com:n0t-invented-here/sweetview-webview-bun.git"
fork_branch := "sweetview"
sub_branch := "sweetview"
upstream := "f1a9d6b"

# `just webview`: the recipes here
@_default:
    just --justfile "{{module_file()}}" --list
clone_dir := "webview-bun"
sub_dir := clone_dir + "/webview"
built_lib := if os() == "windows" { sub_dir + "/build/core/Release/webview.dll" } else { sub_dir + "/build/core/Release/libwebview.dylib" }
build_cmd := "bun scripts/build.ts"
stamp := built_lib + ".commit"

# Where both clones stand: branch, commit, ahead/behind origin, changed files, the submodule pointer and the built library
[script("pwsh", "-NoProfile", "-File")]
[extension(".ps1")]

status:
    $ErrorActionPreference = "Stop"
    if (!(Test-Path "{{clone_dir}}/.git")) { Write-Host "not cloned: just webview clone  (-> {{clone_dir}}/)"; exit 0 }
    foreach ($r in @(@("webview-bun", "{{clone_dir}}", "{{fork_branch}}"), @("webview", "{{sub_dir}}", "{{sub_branch}}"))) {
        $name, $dir, $want = $r
        $branch = (git -C $dir rev-parse --abbrev-ref HEAD).Trim()
        $head = (git -C $dir rev-parse --short HEAD).Trim()
        $dirty = @(git -C $dir status --porcelain).Count
        $ab = (git -C $dir rev-list --left-right --count "HEAD...@{u}" 2>$null)
        $where = if ($branch -eq "HEAD") { "detached" } else { $branch }
        $tree = if ($dirty) { "$dirty changed file(s)" } else { "clean" }
        $sync = if (!$ab) { "no upstream" } else { $a, $b = "$ab".Trim() -split "\s+"; if ($a -eq "0" -and $b -eq "0") { "up to date with origin" } else { "ahead $a, behind $b of origin" } }
        $notes = @()
        if ($branch -ne "HEAD" -and $branch -ne $want) { $notes += "expected branch $want" }
        if ((git -C $dir rev-parse --is-shallow-repository).Trim() -eq "true") { $notes += "shallow; just webview update unshallows" }
        $line = "{0,-12} {1} @ {2}   {3}   {4}" -f $name, $where, $head, $tree, $sync
        if ($notes) { $line += "   (" + ($notes -join "; ") + ")" }
        Write-Host $line
    }
    $pointer = (git -C "{{clone_dir}}" ls-tree HEAD webview).Split()[2]
    $subHead = (git -C "{{sub_dir}}" rev-parse HEAD).Trim()
    if ($pointer -eq $subHead) { Write-Host "pointer      webview-bun records webview $($pointer.Substring(0,7)): matches the checkout" }
    else { Write-Host "pointer      webview-bun records webview $($pointer.Substring(0,7)), the checkout is $($subHead.Substring(0,7)): commit the new pointer in webview-bun" }
    if (!(Test-Path "{{built_lib}}")) { Write-Host "built        none: just webview build" }
    else {
        $from = if (Test-Path "{{stamp}}") { (Get-Content "{{stamp}}" -Raw).Trim() } else { "?" }
        $state = if ($from -eq $subHead) { "current" } elseif ($from -like "*-dirty") { "from uncommitted changes" } else { "stale, webview is at $($subHead.Substring(0,7))" }
        Write-Host "built        {{built_lib}} from webview $(if ($from.Length -ge 7) { $from.Substring(0,7) } else { $from }): $state"
    }

# Full clone of the webview-bun fork with its webview submodule into webview-bun/, both on their branches; skipped when present
[script("pwsh", "-NoProfile", "-File")]
[extension(".ps1")]
clone:
    $ErrorActionPreference = "Stop"
    if (Test-Path "{{clone_dir}}/.git") { Write-Host "already cloned: {{clone_dir}}/"; exit 0 }
    git clone --branch "{{fork_branch}}" --recurse-submodules "{{fork}}" "{{clone_dir}}"; if ($LASTEXITCODE) { exit $LASTEXITCODE }
    # the submodule arrives detached at the recorded commit; put it on its branch so commits can be made and pushed
    git -C "{{sub_dir}}" checkout -q "{{sub_branch}}"; if ($LASTEXITCODE) { exit $LASTEXITCODE }
    Write-Host "cloned {{fork}} ({{fork_branch}}) with webview ({{sub_branch}}) into {{clone_dir}}/"
    $pointer = (git -C "{{clone_dir}}" ls-tree HEAD webview).Split()[2]
    if ($pointer -ne (git -C "{{sub_dir}}" rev-parse HEAD).Trim()) { Write-Host "note: origin/{{sub_branch}} is ahead of the commit webview-bun records; just webview status shows both" }

# Fetch both repos and fast-forward them. A dirty, detached or diverged checkout is reported and left alone, never reset; offline, keeps what it has
[script("pwsh", "-NoProfile", "-File")]
[extension(".ps1")]
update: clone
    $ErrorActionPreference = "Stop"
    foreach ($r in @(@("webview-bun", "{{clone_dir}}", "{{fork_branch}}"), @("webview", "{{sub_dir}}", "{{sub_branch}}"))) {
        $name, $dir, $want = $r
        if ((git -C $dir rev-parse --is-shallow-repository).Trim() -eq "true") { git -C $dir fetch -q --unshallow 2>&1 | Out-Null } else { git -C $dir fetch -q 2>&1 | Out-Null }
        if ($LASTEXITCODE) { Write-Host "${name}: fetch failed (offline?); kept as it is"; continue }
        $branch = (git -C $dir rev-parse --abbrev-ref HEAD).Trim()
        if ($branch -eq "HEAD") { Write-Host "${name}: detached HEAD, not updated (git checkout $want)"; continue }
        $dirty = @(git -C $dir status --porcelain).Count
        if ($dirty) { Write-Host "${name}: $dirty changed file(s), not updated; commit or stash first"; continue }
        $ab = (git -C $dir rev-list --left-right --count "HEAD...@{u}" 2>$null)
        if (!$ab) { Write-Host "${name}: $branch has no upstream, not updated"; continue }
        $ahead, $behind = "$ab".Trim() -split "\s+"
        if ($behind -eq "0") { Write-Host "${name}: $branch up to date$(if ($ahead -ne '0') { " (ahead $ahead, unpushed)" })"; continue }
        if ($ahead -ne "0") { Write-Host "${name}: $branch diverged from origin (ahead $ahead, behind $behind); merge or rebase by hand"; continue }
        $before = (git -C $dir rev-parse --short HEAD).Trim()
        git -C $dir merge -q --ff-only "@{u}"; if ($LASTEXITCODE) { exit $LASTEXITCODE }
        Write-Host "${name}: $branch $before -> $((git -C $dir rev-parse --short HEAD).Trim())"
    }

# Build the library for this OS from the webview checkout (Windows: VS 2022 Build Tools, CMake, ninja; macOS: Xcode CLT, CMake, ninja); skipped when the build already matches the checkout, redone while the checkout has uncommitted changes
[script("pwsh", "-NoProfile", "-File")]
[extension(".ps1")]
build: clone
    $ErrorActionPreference = "Stop"
    if (!($IsWindows -or $IsMacOS)) { throw "the webview library is built on Windows or macOS only" }
    $head = (git -C "{{sub_dir}}" rev-parse HEAD).Trim()
    $want = if (@(git -C "{{sub_dir}}" status --porcelain).Count) { "$head-dirty" } else { $head }
    $have = if (Test-Path "{{stamp}}") { (Get-Content "{{stamp}}" -Raw).Trim() } else { "" }
    if ((Test-Path "{{built_lib}}") -and $have -eq $want -and $want -notlike "*-dirty") { Write-Host "already built from webview $($head.Substring(0,7))"; exit 0 }
    Write-Host "building webview $($head.Substring(0,7))$(if ($want -like '*-dirty') { ' with uncommitted changes' })"
    if ($IsWindows) {
        # no cmd, no .bat: find Visual Studio with vswhere, enter its dev shell here in pwsh, run cmake + ninja like the fork's scripts\build.bat does
        $vswhere = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe"
        if (!(Test-Path $vswhere)) { throw "vswhere.exe not found at ${vswhere}: install Visual Studio 2022 Build Tools with the C++ workload" }
        $vs = (& $vswhere -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath | Select-Object -First 1)
        if (!$vs) { throw "no Visual Studio with the C++ x86/x64 build tools found (vswhere)" }
        Import-Module "$vs\Common7\Tools\Microsoft.VisualStudio.DevShell.dll"
        Enter-VsDevShell -VsInstallPath $vs -SkipAutomaticLocation -DevCmdArguments "-arch=x64 -host_arch=x64" | Out-Null
        foreach ($tool in "cmake", "ninja") { if (!(Get-Command $tool -ErrorAction SilentlyContinue)) { throw "$tool not on PATH: install it (winget install Kitware.CMake / Ninja-build.Ninja)" } }
        Push-Location "{{sub_dir}}"
        try {
            cmake -G "Ninja Multi-Config" -B build -S . -DWEBVIEW_ENABLE_CHECKS=false -DWEBVIEW_BUILD_AMALGAMATION=false -DWEBVIEW_BUILD_EXAMPLES=false -DWEBVIEW_BUILD_STATIC_LIBRARY=false -DWEBVIEW_BUILD_TESTS=false
            $code = $LASTEXITCODE
            if (!$code) { cmake --build build --config Release; $code = $LASTEXITCODE }
        } finally { Pop-Location }
    } else {
        Push-Location "{{clone_dir}}"
        try { {{build_cmd}}; $code = $LASTEXITCODE } finally { Pop-Location }
    }
    if ($code) { exit $code }
    if (!(Test-Path "{{built_lib}}")) { throw "build did not produce {{built_lib}}" }
    # the fork's own build script also overwrites its tracked prebuilt binaries under build/; put those back so the clone stays clean
    git -C "{{clone_dir}}" checkout -q -- build 2>$null
    Set-Content "{{stamp}}" $want -NoNewline
    Write-Host "built {{built_lib}}"

# update, then build
lib: update build

# Push webview's branch, then webview-bun's; says when webview-bun still records an older webview commit
[script("pwsh", "-NoProfile", "-File")]
[extension(".ps1")]
push:
    $ErrorActionPreference = "Stop"
    if (!(Test-Path "{{clone_dir}}/.git")) { throw "not cloned yet: just webview clone" }
    foreach ($r in @(@("webview", "{{sub_dir}}", "{{sub_branch}}"), @("webview-bun", "{{clone_dir}}", "{{fork_branch}}"))) {
        $name, $dir, $want = $r
        $branch = (git -C $dir rev-parse --abbrev-ref HEAD).Trim()
        if ($branch -eq "HEAD") { throw "${name}: detached HEAD; check out $want first" }
        $dirty = @(git -C $dir status --porcelain).Count
        if ($dirty) { Write-Host "${name}: $dirty uncommitted change(s) stay behind" }
        $ab = (git -C $dir rev-list --left-right --count "HEAD...@{u}" 2>$null)
        if ($ab) {
            $ahead, $behind = "$ab".Trim() -split "\s+"
            if ($ahead -eq "0") { Write-Host "${name}: $branch has nothing to push"; continue }
            if ($behind -ne "0") { throw "${name}: $branch is behind origin by $behind; just webview update first" }
        }
        git -C $dir push -q -u origin $branch; if ($LASTEXITCODE) { exit $LASTEXITCODE }
        Write-Host "${name}: pushed $branch ($((git -C $dir rev-parse --short HEAD).Trim()))"
    }
    $pointer = (git -C "{{clone_dir}}" ls-tree HEAD webview).Split()[2]
    if ($pointer -ne (git -C "{{sub_dir}}" rev-parse HEAD).Trim()) { Write-Host "webview-bun still records webview $($pointer.Substring(0,7)); commit the new pointer there and push again" }

# Remove the clones (and with them the build); uncommitted changes go with them, unpushed commits stop it
[script("pwsh", "-NoProfile", "-File")]
[extension(".ps1")]
clean:
    $ErrorActionPreference = "Stop"
    if (!(Test-Path "{{clone_dir}}/.git")) { Write-Host "nothing to remove"; exit 0 }
    foreach ($r in @(@("webview-bun", "{{clone_dir}}"), @("webview", "{{sub_dir}}"))) {
        $name, $dir = $r
        $ab = (git -C $dir rev-list --left-right --count "HEAD...@{u}" 2>$null)
        if ($ab) { $ahead, $behind = "$ab".Trim() -split "\s+"; if ($ahead -ne "0") { throw "$name has $ahead unpushed commit(s); just webview push first (or push them yourself), then clean" } }
        $dirty = @(git -C $dir status --porcelain).Count
        if ($dirty) { Write-Host "${name}: $dirty uncommitted change(s) discarded" }
    }
    Remove-Item "{{clone_dir}}" -Recurse -Force
    Write-Host "removed {{clone_dir}}/"
